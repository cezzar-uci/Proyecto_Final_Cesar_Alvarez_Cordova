# Copia este archivo como .env. No subas .env al repositorio.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taskforge:taskforge@localhost:5432/taskforge
# Genera un secreto fuerte de 32 o mas caracteres. Ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_64_CARACTERES
# Para bases de datos remotas que requieren SSL; en Render/Neon suele ser true
DATABASE_SSL=false
# Opcional: se crea/actualiza un administrador solo cuando ambas variables estan presentes
# ADMIN_EMAIL=admin@ejemplo.com
# ADMIN_PASSWORD=contraseña_segura_de_12_caracteres
